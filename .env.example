# Server
NODE_ENV=dev
PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Full public URL Twilio sends webhooks to — used for signature validation
TWILIO_WEBHOOK_URL=https://your-domain.com/webhooks/twilio

# Unthread
UNTHREAD_API_KEY=your_unthread_api_key
UNTHREAD_SLACK_CHANNEL_ID=your_slack_channel_id
UNTHREAD_WEBHOOK_SECRET=your_webhook_secret

# Storage (Nuvex) — PostgreSQL is required
POSTGRES_URL=postgresql://user:password@localhost:5432/unthread_whatsapp

# Redis is optional but recommended for production caching
REDIS_URL=redis://localhost:6379

# Webhook queue Redis (used with wgtechlabs/unthread-webhook-server)
# Local docker-compose default: redis://localhost:6380
WEBHOOK_REDIS_URL=redis://localhost:6380
