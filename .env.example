# Server
NODE_ENV=dev
PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Full public URL Twilio sends webhooks to — used for signature validation
TWILIO_WEBHOOK_URL=https://your-domain.com/webhooks/twilio

# Unthread
UNTHREAD_API_KEY=your_unthread_api_key
UNTHREAD_SLACK_CHANNEL_ID=your_slack_channel_id
UNTHREAD_WEBHOOK_SECRET=your_webhook_secret

# Slack workspace team ID for outbound file attachment downloads from Dashboard → WhatsApp.
# Used to call the /slack/files/{fileId}/thumb endpoint for images sent from the Dashboard.
# Auto-detected from webhook file URLs when not set, but setting it explicitly is recommended.
# Find it in your Slack workspace URL: https://app.slack.com/client/{TEAM_ID}/...
# SLACK_TEAM_ID=T0123ABCDE

# Storage (Nuvex) — PostgreSQL is required
POSTGRES_URL=postgresql://user:password@localhost:5432/unthread_whatsapp

# Redis is optional but recommended for production caching
REDIS_URL=redis://localhost:6379

# Webhook queue Redis (used with wgtechlabs/unthread-webhook-server)
# Local docker-compose default: redis://localhost:6380
WEBHOOK_REDIS_URL=redis://localhost:6380

# Media proxy (bidirectional file attachment support)
# Public base URL served to Twilio for short-lived media proxy tokens.
# If not set, the origin is derived from TWILIO_WEBHOOK_URL.
# PUBLIC_BASE_URL=https://your-domain.com

# How long (seconds) a media proxy token remains valid. Default: 600 (10 minutes).
# MEDIA_TOKEN_TTL_SECONDS=600

# Maximum inbound attachment size in bytes. Default: 16777216 (16 MB).
# MAX_ATTACHMENT_SIZE_BYTES=16777216
