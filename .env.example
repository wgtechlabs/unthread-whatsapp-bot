# Server
PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Unthread
UNTHREAD_API_KEY=your_unthread_api_key
UNTHREAD_API_URL=https://api.unthread.io/api
UNTHREAD_WEBHOOK_SECRET=your_webhook_secret

# Storage (Nuvex) — PostgreSQL is required
POSTGRES_URL=postgresql://user:password@localhost:5432/unthread_whatsapp

# Redis is optional but recommended for production caching
REDIS_URL=redis://localhost:6379
